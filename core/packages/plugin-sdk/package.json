{
  "name": "@devtoolbox/plugin-sdk",
  "version": "1.0.0",
  "description": "Browser SDK for DevToolBox Marketplace plugins",
  "private": true,
  "license": "Apache-2.0",
  "keywords": [
    "devtoolbox",
    "plugin",
    "sdk",
    "marketplace"
  ],
  "homepage": "https://github.com/jacobs-256/devToolBox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacobs-256/devToolBox.git",
    "directory": "core/packages/plugin-sdk"
  },
  "bugs": {
    "url": "https://github.com/jacobs-256/devToolBox/issues"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "pack:check": "node scripts/check-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
