{
  "name": "devtoolbox",
  "version": "2.0.3",
  "description": "Cross-platform desktop toolbox",
  "author": "Jacobs",
  "license": "Apache-2.0",
  "private": true,
  "main": "dist-electron/main/index.js",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/exec-without-node-options.mjs vite",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc && vite build",
    "bundle:check": "node scripts/check-bundle-budget.mjs",
    "bundle:marketplace": "pnpm -C marketplace bundle:check",
    "supply-chain:generate": "node scripts/generate-supply-chain.mjs",
    "audit:prod": "pnpm audit --prod --audit-level=high",
    "preview": "vite preview",
    "test": "vitest run",
    "test:electron": "electron scripts/electron-smoke.mjs",
    "test:renderer": "electron scripts/renderer-smoke.mjs",
    "new:tool": "node scripts/new-tool.mjs",
    "lint:modules": "node scripts/lint-modules.mjs && node scripts/lint-marketplace.mjs",
    "lint:boundaries": "node scripts/lint-boundaries.mjs",
    "lint:docs": "node scripts/lint-docs.mjs",
    "lint": "pnpm lint:modules && pnpm lint:boundaries && pnpm lint:docs && eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:prepare": "pnpm run build && pnpm run bundle:check && pnpm run supply-chain:generate",
    "package:mac": "pnpm run package:prepare && electron-builder --mac --publish never",
    "package:win": "pnpm run package:prepare && electron-builder --win --publish never",
    "package:all": "pnpm run package:prepare && electron-builder --mac --win --publish never"
  },
  "dependencies": {
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "6.12.3",
    "@codemirror/search": "6.6.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.40.0",
    "bwip-js": "^4.8.0",
    "diff": "^8.0.3",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.6.2",
    "events": "^3.3.0",
    "extract-zip": "^2.0.1",
    "fast-xml-parser": "^5.10.1",
    "highlight.js": "^11.11.1",
    "javascript-obfuscator": "^5.5.0",
    "js-yaml": "^4.3.0",
    "marked": "^17.0.4",
    "mqtt": "^5.15.2",
    "pinyin-pro": "^3.28.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-grid-layout": "^2.2.3",
    "react-icons": "^5.6.0",
    "react-resizable": "^3.2.0",
    "terser": "^5.46.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@codemirror/theme-one-dark": "^6.1.3",
    "@devtoolbox/core": "workspace:*",
    "@devtoolbox/ui": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/bwip-js": "^3.2.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.19.39",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "0.25.12",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.3",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "fast-check": "^3.23.2",
    "jsdom": "^25.0.1",
    "prettier": "^3.8.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.1.10"
  }
}
